__pycache__/
*.pyc
.venv/
venv/
env/
node_modules/
dist/
build/
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.log
*.log.*

# Erzeugte Daten - nie Teil der Bilanz oder des Berichts
.stimmen/
.toene/
.ablage/
.cwb/

# Code-Index (index/): Roberts eigene Vektordatenbank mit fremdem Quellcode
# gehoert niemandem sonst und darf nie mitgepackt werden.
index/chroma_db/
index/manifeste/
index/.sperre
index/*.log
index/*.log.*

# Memory Hub (memory_hub/): Roberts persoenliches Gedaechtnis aus allen
# Projekten - darf nie mitgepackt werden. Eine verschenkte Kopie startet mit
# leerem Gedaechtnis, memory_hub/memory_db.py legt die Datei bei Bedarf
# selbst neu an.
memory_hub/memory.db
memory_hub/memory.db-wal
memory_hub/memory.db-shm
memory_hub/*.log

# Persoenliche Einstellungen: enthaelt die Pfade dieses Rechners,
# das zuletzt geoeffnete Projekt und den Tokenverbrauch.
# Wird beim ersten Start neu angelegt (core/ersteinrichtung.py).
einstellungen.json

# Projektgedaechtnis: Tagebuch, offene Punkte und Archiv beschreiben
# die eigene Arbeit und gehoeren niemandem sonst.
wissen/tagebuch.md
wissen/offen.md
wissen/archiv/

# Auftragsprotokolle: enthalten den Wortlaut jedes Auftrags.
.cwb/protokoll/

# Sicherungskopien und Testaufnahmen
*.bak
*.orig
*.rej
.probe_*.png

# Gesicherte alte Historie - gehoert nicht ins neue Repository.
.git_alt/

# Betriebssystem und Editor
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
